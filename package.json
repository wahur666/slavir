    "phaser": "^4.2.1"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.73.0",
    "@typescript-eslint/parser": "^8.73.0",
    "css-loader": "^7.1.5",
    "eslint": "^10.15.0",
    "html-webpack-plugin": "^5.6.8",
    "style-loader": "^4.0.0",
