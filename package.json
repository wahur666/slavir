{
  "name": "slavir",
  "version": "0.0.1",
  "description": "Open-source Real Time Tactics Game",
  "main": "index.js",
  "scripts": {
    "test": "npm run build && vitest run",
    "test:unit": "vitest run --project unit",
    "test:e2e": "npm run build && vitest run --project e2e",
    "test:watch": "vitest --project unit",
    "typecheck": "tsc --noEmit -p src && tsc --noEmit -p tests && tsc --noEmit -p server",
    "server": "tsx server/server.ts",
    "bot": "tsx server/bot.ts",
    "sprites": "tsx site/powerSprites.ts",
    "build": "tsc --noEmit -p src && vite build --mode development",
    "watch": "vite build --mode development --watch",
    "dev": "vite",
    "prod": "tsc --noEmit -p src && vite build",
    "zip": "zip slavir.zip -r ./public/ -j /public/",
    "release": "npm run prod && npm run zip",
    "preview": "vite preview --port 8081",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check .",
    "check:fix": "biome check --write ."
  },
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wahur666/slavir.git"
  },
  "keywords": [
    "phaser3",
    "game"
  ],
  "author": "Szecsodi Imre",
  "license": "GPL-3.0-or-later",
  "bugs": {
    "url": "https://github.com/wahur666/slavir/issues"
  },
  "homepage": "https://github.com/wahur666/slavir#readme",
  "dependencies": {
    "@preact/signals": "^2.11.4",
    "heap-js": "^2.7.1",
    "phaser": "^4.2.1",
    "preact": "^11.2.0",
    "ws": "^8.23.0"
  },
  "type": "module",
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@napi-rs/canvas": "^1.2.0",
    "@types/node": "^26.6.6",
    "@types/ws": "^8.18.2",
    "marked": "^18.2.1",
    "mermaid": "^12.3.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
