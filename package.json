{
  "name": "slavir",
  "version": "0.0.1",
  "description": "Open-source Real Time Tactics Game",
  "main": "index.js",
  "scripts": {
    "test": "npm run build && node tests/gameplay.cjs",
    "build": "tsc --noEmit -p src && vite build --mode development",
    "watch": "vite build --mode development --watch",
    "dev": "vite",
    "prod": "tsc --noEmit -p src && vite build",
    "zip": "zip slavir.zip -r ./public/ -j /public/",
    "release": "npm run prod && npm run zip",
    "preview": "vite preview --port 8081"
  },
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wahur666/slavir.git"
  },
  "keywords": [
    "phaser3",
    "game"
  ],
  "author": "Szecsodi Imre",
  "license": "GPL-3.0-or-later",
  "bugs": {
    "url": "https://github.com/wahur666/slavir/issues"
  },
  "homepage": "https://github.com/wahur666/slavir#readme",
  "dependencies": {
    "heap-js": "^2.7.1",
    "phaser": "^4.2.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@typescript-eslint/eslint-plugin": "^8.73.0",
    "@typescript-eslint/parser": "^8.73.0",
    "eslint": "^10.15.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.8"
  }
}
